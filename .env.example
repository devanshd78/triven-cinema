# Triven Cinema API
APP_NAME="Triven Cinema API"
APP_ENV="development"
AUTH_ENABLED=true
DEMO_AUTH_SHOW_OTP=true
# To exercise real email delivery locally, disable demo codes and fill these.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS=true
SMTP_USE_SSL=false
DEBUG=true
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Production only: public hostname used by host Nginx on the Hostinger VPS.
TRIVEN_DOMAIN=""

# Gemini scene planner
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT_SECONDS=20
GEMINI_THINKING_LEVEL="low"
GEMINI_FALLBACK_MODELS="gemini-3.7-flash,gemini-3.6-flash"
GEMINI_MAX_ATTEMPTS_PER_MODEL=3
GEMINI_RETRY_BACKOFF_SECONDS=0.8

# Default inference provider: huggingface or modal
VIDEO_PROVIDER="huggingface"

# Hugging Face development provider
HF_TOKEN=""
HF_LTX_SPACE="ChopperBlu/ltx-2-5-demo"

# Modal production provider
# On a VPS/container, authenticate the Modal client with a dedicated API token.
MODAL_TOKEN_ID=""
MODAL_TOKEN_SECRET=""
MODAL_APP_NAME="triven-cinema-ltx"
MODAL_FUNCTION_NAME="generate_video"
MODAL_AUDIO_RETAKE_FUNCTION_NAME="retake_audio"
# Used at Modal deployment time. B200 is the requested benchmark target.
TRIVEN_MODAL_GPU="B200"
TRIVEN_MODAL_SCALEDOWN_WINDOW=15
# Pin this to the validated LTX-2 commit/tag before a long-lived production deployment.
TRIVEN_LTX_REPO_REF="v1.4.2"

# Optional cost estimates. Copy CURRENT hourly prices from your Modal dashboard.
# Keep 0 until verified. These are estimates, not billed-cost statements.
MODAL_GPU_HOURLY_USD_B200=0
MODAL_GPU_HOURLY_USD_H200=0
MODAL_GPU_HOURLY_USD_H100=0

# Render defaults
DEFAULT_RENDER_QUALITY="preview"
DEFAULT_DECODER="conv"
DEFAULT_SCENE_DURATION_SECONDS=20
# Factory timing profile. LTX-2.5 15-20s scenes run as one native generation.
# 1080p may expose a 30s DFR/B200 single-pass experiment; it is not stitched from sub-clips.
LTX_NATIVE_CHUNK_SECONDS=20
MAX_PREVIEW_SCENE_SECONDS=20
MAX_1080P_SCENE_SECONDS=30
MAX_4K_SCENE_SECONDS=15
MAX_FACTORY_DURATION_SECONDS=300
FACTORY_MIN_SCENE_SECONDS=15
FACTORY_STANDARD_MAX_SCENE_SECONDS=20
FACTORY_ENABLE_30S_1080P_SINGLE_PASS=true
FACTORY_EXPERIMENTAL_1080P_SCENE_SECONDS=30
# Final 1080p/4K jobs stop before paid GPU rendering if Gemini planning is unavailable.
FACTORY_ALLOW_FALLBACK_FINAL=false
FACTORY_AUDIO_QC_ENABLED=true
FACTORY_AUDIO_RETAKE_ENABLED=true
FACTORY_AUDIO_QC_STRICT_FINAL=true

# Reusable Elements / reference identity system
ELEMENT_MAX_STORED_PER_WORKSPACE=100
ELEMENT_MAX_ASSETS_PER_ELEMENT=8
ELEMENT_MAX_ACTIVE_PER_SCENE=6
ELEMENT_MAX_CHARACTERS_PER_SCENE=3
ELEMENT_MAX_PROPS_PER_SCENE=3
ELEMENT_MAX_LOCATIONS_PER_SCENE=1
ELEMENT_MAX_STYLES_PER_SCENE=1
ELEMENT_MAX_UPLOAD_MB=15
ELEMENT_ASSET_URL_TTL_SECONDS=21600
ELEMENT_REFERENCE_SHEET_WIDTH=768
ELEMENT_REFERENCE_SHEET_HEIGHT=448
ELEMENT_INGREDIENTS_ENABLED=true
ELEMENT_INGREDIENTS_STRENGTH=1.0
ELEMENT_INGREDIENTS_MAX_SCENE_SECONDS=20

# Character cardinality / duplicate-subject guard.
CONTINUITY_VISION_QC_ENABLED=true
CONTINUITY_QC_TIMEOUT_SECONDS=12
CONTINUITY_QC_MAX_FRAMES=3

# Signed browser workspace identity. Required in production when Billing or YouTube is enabled.
TRIVEN_SECRET_KEY=""

# Stripe Checkout credit packs. Keep enforcement off until live webhook verification is complete.
BILLING_ENABLED=false
BILLING_ENFORCE_CREDITS=false
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_STUDIO=""
STRIPE_STARTER_SECONDS=300
STRIPE_PRO_SECONDS=1800
STRIPE_STUDIO_SECONDS=7200

# Connected YouTube channel. OAuth callback must be registered in Google Cloud.
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI=""
# Keep false until the Google API project/channel flow is ready for non-private publishing.
YOUTUBE_ALLOW_PUBLIC=false

# Single-VPS job/cost safety
JOB_WORKERS=1
JOB_MAX_PENDING=3
JOB_RETENTION_DAYS=14
ENABLE_SYNC_RENDER_ENDPOINTS=true
ENABLE_METRICS_ENDPOINT=true

# VPS disk retention
PREVIEW_RETENTION_DAYS=3
FINAL_RETENTION_DAYS=30
MINIMUM_FREE_DISK_GB=10
METRICS_MAX_BYTES=10485760

# Local FFmpeg/ffprobe safety timeouts
FFMPEG_TIMEOUT_SECONDS=900
FFPROBE_TIMEOUT_SECONDS=30
LOG_MAX_BYTES=20971520
